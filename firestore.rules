rules_version = '2';

// Cricket Umpire — match sharing rules.
// • Anyone signed in (everyone is, at least anonymously) can READ all matches.
// • You can only create a match owned by yourself.
// • Only the match's creator — or the admin — can update or delete it.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'kingmalhi22g@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /matches/{matchId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || isAdmin());

      // Deleting a never-synced (non-existent) doc is a harmless no-op, so allow
      // it — otherwise local-only matches could never be deleted.
      allow delete: if request.auth != null
        && (resource == null
            || resource.data.ownerId == request.auth.uid
            || isAdmin());
    }

    // Device handoff: lets an anonymous scorer move a live match to another
    // device without signing in. The RECEIVING device registers a short code
    // pointing at its own uid; the CURRENT owner reads that code and rewrites
    // the match's ownerId to it (allowed by the matches `update` rule above,
    // since the current owner may change any field). The code reveals only a
    // uid + matchId — useless to anyone who isn't already the match's owner.
    match /handoffs/{code} {
      allow read: if request.auth != null;
      // You may only register a code that points at yourself, and create-only
      // (no overwrite) so a squatter can't repoint someone else's pending code.
      allow create: if request.auth != null
        && request.resource.data.newUid == request.auth.uid
        && request.resource.data.matchId is string;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Feedback: anyone signed in (incl. anonymous) may submit a message;
    // only the admin can read or delete it. No updates.
    match /feedback/{feedbackId} {
      allow read, delete: if isAdmin();
      allow create: if request.auth != null
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 1000;
      allow update: if false;
    }
  }
}
