{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "app",
      "public": ".",
      "ignore": [
        "firebase.json",
        ".firebaserc",
        "**/.*",
        ".git/**",
        ".github/**",
        ".firebase/**",
        ".claude/**",
        "**/node_modules/**",
        "icons/_preview/**",
        "redirect/**",
        "*.md",
        "server.js",
        "firestore.rules",
        "*.bat"
      ],
      "headers": [
        {
          "source": "/index.html",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        },
        {
          "source": "/service-worker.js",
          "headers": [
            { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
          ]
        }
      ]
    },
    {
      "target": "old",
      "public": "redirect",
      "ignore": ["firebase.json", ".firebaserc", "**/.*"],
      "redirects": [
        { "source": "**", "destination": "https://scoringbook.web.app", "type": 301 }
      ]
    }
  ]
}
